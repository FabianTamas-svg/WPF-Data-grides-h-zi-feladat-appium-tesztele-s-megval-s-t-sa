<Window x:Class="WpfGyakorlat_Fabian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Microsoft Education Dashboard" Height="650" Width="950" 
        Background="#F3F6F9" WindowStartupLocation="CenterScreen">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Szia, Fábián! 👋" FontSize="16" FontWeight="SemiBold" Foreground="#5E6E82"/>
            <TextBlock Text="Tanulmányi Napló" FontSize="36" FontWeight="ExtraBold" Foreground="#212B36"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="20" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Direction="-90" Opacity="0.05" ShadowDepth="4"/>
            </Border.Effect>

            <DataGrid Name="dgDiakok" AutoGenerateColumns="False" 
                      Background="Transparent" BorderThickness="0" 
                      RowBackground="Transparent" AlternatingRowBackground="#F8FAFD"
                      Foreground="#212B36" FontSize="15" RowHeight="50"
                      GridLinesVisibility="None" CanUserAddRows="True">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#919EAB"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,15"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#F1F3F5"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="HALLGATÓ" Binding="{Binding Nev}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="OSZTÁLY" Binding="{Binding Osztaly}" Width="150"/>
                    <DataGridTextColumn Header="MATEK" Binding="{Binding Matek}" Width="100"/>
                    <DataGridTextColumn Header="FIZIKA" Binding="{Binding Fizika}" Width="100"/>

                    <DataGridTemplateColumn Header="ÁTLAG" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Atlag}" Foreground="#1976D2" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,30,0,0">
            <Button Content="Adatok Mentése" Width="180" Height="50" Click="Button_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#212B36"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>